{
  "expo": {
    "name": "MyTasks",
    "slug": "MyTasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "MyTasks utilise la caméra pour joindre une photo à une tâche.",
          "photosPermission": "MyTasks accède à vos photos pour joindre une image à une tâche."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyTasks utilise votre position pour les rappels de lieu."
        }
      ],
      "expo-notifications"
    ]
  }
}
